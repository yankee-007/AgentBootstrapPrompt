{
  "name": "task-worktree-remotion-demo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "preview": "vite preview",
    "studio": "remotion studio src/remotion.tsx",
    "render": "remotion render src/remotion.tsx TaskWorktree out/task-worktree-demo.mp4 --codec=h264 --crf=18 --concurrency=4"
  },
  "dependencies": {
    "@remotion/player": "4.0.534",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.534"
  },
  "devDependencies": {
    "@remotion/cli": "4.0.534",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
